{
  "rules": {
    ".read": false,
    ".write": false,
    "usernames": {
      ".read": true,
      "$nameLower": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val() === auth.uid && $nameLower.matches(/^[a-z0-9_]{3,16}$/)"
      }
    },
    "players": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "cash": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1e15"
        },
        "netWorth": {
          ".validate": "newData.isNumber() && newData.val() < 1e15"
        },
        "updated": {
          ".validate": "newData.isNumber()"
        },
        "inbox": {
          "$item": {
            ".write": "auth != null && (auth.uid === $uid ? true : (!data.exists() && newData.exists() && newData.child('from').val() === auth.uid))",
            ".validate": "newData.hasChildren(['type','from','ts']) && newData.child('from').val() === auth.uid && (newData.child('type').val() === 'cash' || newData.child('type').val() === 'asset')",
            "amount": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 1e12"
            },
            "units": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "assetId": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "fromName": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "$other": {
              ".validate": true
            }
          }
        }
      }
    },
    "leaderboard": {
      ".read": true,
      ".indexOn": "netWorth",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','netWorth','ts'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "netWorth": {
          ".validate": "newData.isNumber() && newData.val() < 1e15"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        }
      }
    },
    "market": {
      "flow": {
        ".read": true,
        "$assetId": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() > -5000000001 && newData.val() < 5000000001"
        }
      }
    },
    "feed": {
      ".read": true,
      ".indexOn": "ts",
      "$item": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['act','sym','ts','uid'])",
        "sym": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "act": {
          ".validate": "newData.val() === 'buy' || newData.val() === 'sell'"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "presence": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','ts'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        }
      }
    },
    "reports": {
      ".read": false,
      "$report": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['kind','title','uid','ts'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 90"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length <= 1500"
        },
        "context": {
          ".validate": "newData.isString() && newData.val().length <= 1200"
        },
        "kind": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        }
      }
    },
    "chat": {
      ".read": true,
      ".indexOn": "ts",
      "$msg": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['name','text','ts'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "uid": {
          ".validate": "newData.val() === auth.uid"
        }
      }
    }
  }
}